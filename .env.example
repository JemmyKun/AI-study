# 配置模板：复制为 .env 后填入真实密钥
# .env 已在 .gitignore 中，请勿提交真实密钥

# ============ 模型服务（DeepSeek，OpenAI 兼容）============
# 注意：地址末尾不要加 /v1，SDK 会自动拼接 /chat/completions
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
COPILOT_MODEL=openai/deepseek-chat

# 使用 OpenAI 官方时改为：
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# COPILOT_MODEL=openai/gpt-4.1-mini

# ============ Copilot Runtime（服务端专用，绝不能加 REACT_APP_ 前缀）============
COPILOT_RUNTIME_PORT=8200
# 监听地址：生产保持 127.0.0.1（只允许本机反代访问）；
# 容器部署且需要外部访问时改为 0.0.0.0
COPILOT_RUNTIME_HOST=127.0.0.1
# CORS：留空=关闭（同域反代推荐）；*=允许任意来源；或填白名单域名，逗号分隔
# COPILOT_CORS_ORIGIN=https://app.example.com

# ============ DeepSeek 代理（/ai-chat 页面使用，服务端专用）============
# 不填 DEEPSEEK_API_KEY 时会回落到 MODEL_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 允许前端切换的模型白名单，逗号分隔
DEEPSEEK_ALLOW_MODELS=deepseek-chat,deepseek-reasoner
# 系统提示词由服务端注入，前端无法篡改（可选）
# DEEPSEEK_SYSTEM_PROMPT=你是一个乐于助人的 AI 助手。

DEEPSEEK_PROXY_PORT=8300
# 监听地址：生产保持 127.0.0.1（只允许本机反代访问）
DEEPSEEK_PROXY_HOST=127.0.0.1
# CORS：留空=关闭（同域反代推荐）；*=任意来源；或填白名单域名，逗号分隔
# DEEPSEEK_CORS_ORIGIN=https://app.example.com

# ============ 前端 ============
# 推荐留空：前端会用 public/config.js 的 window.__COPILOT_RUNTIME_URL__（默认 /api/copilotkit），
# 部署后改 config.js 即可切换环境，无需重新打包。
# 只有在"构建时就要固定地址"的场合才设置它：
# REACT_APP_COPILOTKIT_RUNTIME_URL=https://copilot.example.com/api/copilotkit
# DeepSeek 页面同理，默认走 public/config.js 的 /api/deepseek
# REACT_APP_DEEPSEEK_API_URL=https://deepseek.example.com/api/deepseek
